<div class="col">
  <div class="card h-100 hoverable project-card">
    {% if project.img %}
      <a class="project-card-media" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      </a>
    {% endif %}
    <div class="card-body">
      <h2 class="card-title">
        <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
          {{ project.title }}
        </a>
      </h2>
      <p class="card-text">{{ project.description }}</p>
      {% include project_links.liquid project=project compact=true %}
    </div>
  </div>
</div>
