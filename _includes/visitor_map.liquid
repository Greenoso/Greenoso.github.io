{% if site.visitor_map.enabled and site.visitor_map.provider == 'clustrmaps' and site.visitor_map.clustrmaps_id %}
  <div class="visitor-map">
    <div class="visitor-map-title">
      <i class="fa-solid fa-location-dot"></i>
      <span>visitor map</span>
    </div>
    <script
      {% if site.enable_cookie_consent %}
        type="text/plain" data-category="analytics"
      {% endif %}
      id="clustrmaps"
      src="https://cdn.clustrmaps.com/map_v2.js?cl={{ site.visitor_map.color | default: 'ffffff' }}&w={{ site.visitor_map.width | default: 220 }}&t={{ site.visitor_map.text | default: 'n' }}&d={{ site.visitor_map.clustrmaps_id }}"
    ></script>
  </div>
{% endif %}
