<div class="col mb-4">
  <div class="card h-100 hoverable project-card">
    <div class="row no-gutters">
      {% if project.img %}
        <div class="col-md-6">
          <a class="project-card-media" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
            {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 156px, 50vw" alt="project thumbnail" class="card-img" %}
          </a>
        </div>
      {% endif %}
      <div class="{% if project.img %}col-md-6{% else %}col-md-12{% endif %}">
        <div class="card-body">
          <h3 class="card-title">
            <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
              {{ project.title }}
            </a>
          </h3>
          <p class="card-text">{{ project.description }}</p>
          {% include project_links.liquid project=project compact=true %}
        </div>
      </div>
    </div>
  </div>
</div>
